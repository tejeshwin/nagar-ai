# API Keys Configuration
# Copy this file to .env and fill in your actual API keys

# Sarvam AI API Key (for Indic language transcription)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=saarika:v1

# Llama API Key (for text refinement)
LLAMA_API_KEY=your_llama_api_key_here
LLAMA_API_BASE_URL=https://api.llama-api.com

# OpenAI API Key (for Whisper transcription - alternative)
OPENAI_API_KEY=your_openai_api_key_here

# Alternative: AI4Bharat API Key (for Indic language support)
AI4BHARAT_API_KEY=your_ai4bharat_api_key_here

# OpenAI API Key (optional, for text-based location extraction)
# If not provided, the system will use basic regex patterns
OPENAI_API_KEY_TEXT=your_openai_api_key_here

# Server Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,m4a,ogg
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png

# Audio Processing
SILENCE_THRESHOLD=-40  # dB
MIN_SILENCE_LENGTH=500  # ms
SILENCE_KEEP=100  # ms

# Image Processing
FACE_DETECTION_CONFIDENCE=0.7
BLUR_KERNEL_SIZE=51
